<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>qlsk-local-development-803b1836</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="docs/testcases/**/*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <EmbeddedResource Include="Data/Migrations/*.sql" />
    <EmbeddedResource Include="Data/seed/*.sql;Data/seed/*.png" LogicalName="QLSK.Data.Seed.%(Filename)%(Extension)" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
  </ItemGroup>
</Project>
