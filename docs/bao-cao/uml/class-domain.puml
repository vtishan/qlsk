}
class GiuGhe {
Id: int
ChiTietDonHangId: int
GheId: int?
}
class Ve {
Id: int
ChiTietDonHangId: int?
SuatDienId: int
GheId: int?
}
class NhatKyCheckIn {
Id: int
VeId: int
NhanVienId: int
}
class DiaDiem {
Id: int
}
class KhuVuc {
Id: int
DiaDiemId: int
}
class Ghe {
Id: int
