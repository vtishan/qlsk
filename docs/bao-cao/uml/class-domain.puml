@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam dpi 140
skinparam backgroundColor white
skinparam wrapWidth 210
skinparam maxMessageSize 90
hide methods
class TaiKhoan {
Id: int
VaiTro: VaiTroTaiKhoan
}
class HoSoBTC {
Id: int
TaiKhoanId: int
}
class SuKien {
