{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "QLSK",
    "Audience": "QLSK.Client",
    "Key": "",
    "ExpireMinutes": 120
  },
  "Order": {
    "ExpireMinutes": 15,
    "MaxPendingOrders": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://127.0.0.1:5000"
    ]
  },
  "PayOS": {
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "ReturnUrl": "",
    "CancelUrl": ""
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "",
    "EnableSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false,
        "IncludeScopes": false,
        "SingleLine": false,
        "ColorBehavior": "Enabled"
      }
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "MaxConcurrentRequests": 64,
    "RequestTimeoutSeconds": 30,
    "RequestsPerMinute": 240,
    "AuthRequestsPerMinute": 15,
    "WritesPerMinute": 30
  }
}
